{
  "name": "obsidian-conflict-resolver",
  "version": "0.1.2",
  "description": "An Obsidian plugin for safely resolving sync-conflict copies.",
  "private": true,
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
